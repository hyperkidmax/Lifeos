rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all for Zero-Trust baseline
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation blueprints
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function isValidUserGoals(data, userId) {
      return data.userId == userId &&
             data.keys().hasAll(['userId', 'dailySteps', 'dailyWaterMl']) &&
             data.keys().hasOnly(['userId', 'dailySteps', 'dailyActiveCalories', 'dailyWaterMl', 'dailyCalories', 'dailyProteinG', 'dailyCarbsG', 'dailyFatG', 'dailySleepMinutes', 'targetWeightKg', 'updatedAt']) &&
             data.dailySteps is number && data.dailySteps >= 0 && data.dailySteps <= 200000 &&
             data.dailyWaterMl is number && data.dailyWaterMl >= 0 && data.dailyWaterMl <= 20000;
    }

    function isValidCloudBackup(data, userId) {
      return data.userId == userId &&
             data.keys().hasAll(['userId', 'backupData', 'lastSyncedAt']) &&
             data.keys().hasOnly(['userId', 'backupData', 'lastSyncedAt', 'recordCounts']) &&
             data.backupData is string && data.backupData.size() <= 1048576 &&
             data.lastSyncedAt is number;
    }

    function isValidWaterLog(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             data.amountMl is number && data.amountMl > 0 && data.amountMl <= 10000 &&
             data.timestamp is number;
    }

    function isValidMealLog(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.calories is number && data.calories >= 0 && data.calories <= 20000 &&
             data.timestamp is number;
    }

    function isValidWorkoutLog(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 1440 &&
             data.timestamp is number;
    }

    function isValidJournalEntry(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             data.mood is number && data.mood >= 1 && data.mood <= 5 &&
             data.energy is number && data.energy >= 1 && data.energy <= 5 &&
             data.reflection is string && data.reflection.size() <= 5000 &&
             data.timestamp is number;
    }

    function isValidBodyLog(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             data.weightKg is number && data.weightKg > 0 && data.weightKg <= 500 &&
             data.timestamp is number;
    }

    function isValidHabit(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.targetDaysPerWeek is number && data.targetDaysPerWeek >= 1 && data.targetDaysPerWeek <= 7;
    }

    function isValidDailyPriority(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 200 &&
             data.completed is bool &&
             data.order is number;
    }

    function isValidStepLog(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             data.count is number && data.count >= 0 && data.count <= 250000 &&
             data.timestamp is number;
    }

    function isValidSleepLog(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             data.totalMinutes is number && data.totalMinutes >= 0 && data.totalMinutes <= 1440 &&
             data.timestamp is number;
    }

    function isValidHeartRateLog(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             (!data.keys().hasAny(['restingBpm']) || (data.restingBpm is number && data.restingBpm >= 30 && data.restingBpm <= 250)) &&
             (!data.keys().hasAny(['avgBpm']) || (data.avgBpm is number && data.avgBpm >= 30 && data.avgBpm <= 250)) &&
             data.timestamp is number;
    }

    function isValidSavedFood(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.calories is number && data.calories >= 0 && data.calories <= 20000;
    }

    // User profile matching
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().userId == existing().userId;
      allow delete: if isValidId(userId) && isOwner(userId);

      // User daily goals
      match /goals/{goalId} {
        allow get: if isValidId(userId) && isValidId(goalId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(goalId) && isOwner(userId) && isValidUserGoals(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(goalId) && isOwner(userId) && isValidUserGoals(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(goalId) && isOwner(userId);
      }

      // Cloud backup bundle
      match /cloudBackup/{backupId} {
        allow get: if isValidId(userId) && isValidId(backupId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(backupId) && isOwner(userId) && isValidCloudBackup(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(backupId) && isOwner(userId) && isValidCloudBackup(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(backupId) && isOwner(userId);
      }

      // Hydration subcollection
      match /waterLogs/{logId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(logId) && isOwner(userId) && isValidWaterLog(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(logId) && isOwner(userId) && isValidWaterLog(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(logId) && isOwner(userId);
      }

      // Meals subcollection
      match /mealLogs/{mealId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(mealId) && isOwner(userId) && isValidMealLog(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(mealId) && isOwner(userId) && isValidMealLog(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(mealId) && isOwner(userId);
      }

      // Workouts subcollection
      match /workoutLogs/{workoutId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(workoutId) && isOwner(userId) && isValidWorkoutLog(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(workoutId) && isOwner(userId) && isValidWorkoutLog(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(workoutId) && isOwner(userId);
      }

      // Journal subcollection
      match /journalEntries/{journalId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(journalId) && isOwner(userId) && isValidJournalEntry(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(journalId) && isOwner(userId) && isValidJournalEntry(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(journalId) && isOwner(userId);
      }

      // Body measurement subcollection
      match /bodyLogs/{bodyLogId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(bodyLogId) && isOwner(userId) && isValidBodyLog(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(bodyLogId) && isOwner(userId) && isValidBodyLog(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(bodyLogId) && isOwner(userId);
      }

      // Habits subcollection
      match /habits/{habitId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(habitId) && isOwner(userId) && isValidHabit(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(habitId) && isOwner(userId) && isValidHabit(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(habitId) && isOwner(userId);
      }

      // Priorities subcollection
      match /dailyPriorities/{priorityId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(priorityId) && isOwner(userId) && isValidDailyPriority(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(priorityId) && isOwner(userId) && isValidDailyPriority(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(priorityId) && isOwner(userId);
      }

      // Steps subcollection
      match /stepLogs/{stepId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(stepId) && isOwner(userId) && isValidStepLog(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(stepId) && isOwner(userId) && isValidStepLog(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(stepId) && isOwner(userId);
      }

      // Sleep subcollection
      match /sleepLogs/{sleepId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(sleepId) && isOwner(userId) && isValidSleepLog(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(sleepId) && isOwner(userId) && isValidSleepLog(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(sleepId) && isOwner(userId);
      }

      // Heart Rate subcollection
      match /heartRateLogs/{hrId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(hrId) && isOwner(userId) && isValidHeartRateLog(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(hrId) && isOwner(userId) && isValidHeartRateLog(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(hrId) && isOwner(userId);
      }

      // Saved Foods subcollection
      match /savedFoods/{foodId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(foodId) && isOwner(userId) && isValidSavedFood(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(foodId) && isOwner(userId) && isValidSavedFood(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(foodId) && isOwner(userId);
      }
    }
  }
}
